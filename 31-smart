#!/usr/bin/env bash

# exit if smartmontools is not installed
if ! command -v smartctl >/dev/null 2>&1; then
  printf "SMART Status Unavailable\n\n"
  exit 0
fi

# number of columns to display
cols=4

# colors
green=$'\e[1;32m'
red=$'\e[1;31m'
yellow=$'\e[1;33m'
reset=$'\e[0m'

# get list of disks
disks=($(lsblk -dn -o NAME,TYPE | awk '$2 == "disk" {print $1}'))
if (( ${#disks[@]} == 0 )); then
  printf 'No disks detected.\n\n'
  exit 0
fi

# print heading
printf 'SMART Status:\n'

out=""
col=0

# add SMART results to output
for disks in "${disks[@]}"; do
  ((++col))
  smart_test=$(smartctl -H /dev/"${disks}" 2>/dev/null | grep '^SMART overall\|^SMART Health Status')
  status="${smart_test##*: }"

  # green if passed, red if failed, yellow if unknown
  case "${status^^}" in
    PASSED|OK)
      out+="${disks}:,${green}${status,,},${reset}"
      ;;
    FAILED*)
      out+="${disks}:,${red}${status,,},${reset}"
      ;;
    *)
      out+="${disks}:,${yellow}unknown,${reset}"
      ;;
  esac

  # newline every $cols column
  if (( col  % cols == 0 )); then
    out+="\n"
  fi
done

out+="\n"
# print output
echo -e "$out" | column -ts $','
printf '\n'
