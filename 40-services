#!/usr/bin/env bash

# check for systemctl
command -v systemctl >/dev/null 2>&1 || exit 0

# set colours
green=$'\e[1;32m'
red=$'\e[1;31m'
yellow=$'\e[1;33m'
reset=$'\e[0m'

# number of columns to display
display_columns=3

# services to display
# key = service name to be displayed, value = possible systemd unit names
declare -A services
services["DNS"]="dnsmasq"
services["Apache"]="apache2 httpd"
services["OpenVPN"]="openvpn"
services["MariaDB"]="mariadb"
services["Jellyfin"]="jellyfin"
services["Radicale"]="radicale"

# sort the service names
mapfile -t sorted_services < <(printf '%s\n' "${!services[@]}" | sort )

cols=0
out=""

# build output
for service in "${sorted_services[@]}"; do
  ((++cols))
  unit=""
  service_status="not found"

  for candidate in ${services[$service]}; do
    load_state=$(systemctl show "$candidate" --property=LoadState --value 2>/dev/null)
    if [[ "$load_state" == "loaded" ]]; then
      unit=$candidate
       break
    fi
  done

  # get service status
  if [[ -n $unit ]]; then
    service_status=$(systemctl is-active "$unit" 2>/dev/null)
    service_status=${service_status:-unknown}
  fi

  # set colour
  case "$service_status" in
    active)
      colour=$green
      ;;
    failed|"not found")
      colour=$red
      ;;
    *)
      colour=$yellow
      ;;
  esac

  out+="${service}:, ${colour}${service_status}${reset},"

  # insert \n every $COLUMNS column
  if [ $((("$cols") % "$display_columns")) -eq 0 ]; then
    out+="\n"
  fi
done

out+="\n"

# print output
printf 'Services:\n'
printf '%b' "$out" | column -ts $','
printf '\n'
