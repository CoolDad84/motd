#!/usr/bin/env bash

# disk alert levels (% used)
warn_lvl=70
alert_lvl=90

# colors
green=$'\e[1;32m'
yellow=$'\e[1;33m'
red=$'\e[1;31m'
grey=$'\e[0;90m'
reset=$'\e[0m'

# bar chart width
bar_width=50

# get disk usage - ignore zfs, squashfs, tmpfs, cifs, nfs and efi partitions
mapfile -t disks < <(df -h -x zfs -x squashfs -x tmpfs -x devtmpfs -x cifs -x nfs -x nfs4 -x overlay --output=target,pcent,used,size | grep -vi '/efi'| tail -n +2)
printf 'Disk Usage:\n'

# build the bar chart
for disk in "${disks[@]}"; do

  # get disk usage %
  usage_pc=$(echo "$disk" | awk '{print $2}' | sed 's/%//')
  used_width="$((usage_pc * bar_width / 100))"
  (( used_width > bar_width )) && used_width="$bar_width"

  # color is red if usage >= alarm level, yellow if usage >= warning level, else green
  if (( usage_pc >= alert_lvl )); then
    used_colour="$red"
  elif (( usage_pc >= warn_lvl )); then
    used_colour="${yellow}"
  else
    used_colour="${green}"
  fi

  # add coloured bar until used_width
  bar="${grey}[${used_colour}"
  for ((i=0; i < used_width; i++)); do
    bar+="―"
  done

  # add grey bar until bar_width
  bar+="${grey}"
  for ((i=used_width; i < bar_width; i++)); do
    bar+="―"
  done

  bar+="${grey}]${reset}"

  # print usage & bar chart
  echo "${disk}" | awk '{ printf("%-37s%+3siB / %+4siB\n", $1, $3, $4); }'
  printf '%s\n' "$bar"
done

echo
